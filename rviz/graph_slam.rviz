Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SLAM Graph
      Marker Topic:
        Value: /slam_graph
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: SLAM Path
      Topic:
        Value: /slam/path
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Ground Truth Path
      Color: 255; 0; 0
      Topic:
        Value: /slam/gt_path
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: Current Pose
      Topic:
        Value: /slam/pose
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Localization
      Topic:
        Value: /slam/localization
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.785
      Yaw: 0.785
